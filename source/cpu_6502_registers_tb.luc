testbench cpu_6502_registers_tb {

    cpu_6502_registers dut

    test reset_test {

        dut.clk = 0
        dut.data_in = 8h00
        dut.load_a = 0
        dut.rst = 1
        $tick()

        $assert(dut.a == 8h00)
        $assert(dut.x == 8h00)
        $assert(dut.y == 8h00)
        $assert(dut.sp == 8h00)
        $assert(dut.pc == 16h0000)
        $assert(dut.p == 8h00)

        dut.rst = 0
        dut.data_in = 8h5A
        dut.load_a = 1
        $tick()

        $assert(dut.a == 8h5A)
        $assert(dut.x == 8h00)
        $assert(dut.y == 8h00)
        $assert(dut.sp == 8h00)
        $assert(dut.pc == 16h0000)
        $assert(dut.p == 8h00)
    }
}


