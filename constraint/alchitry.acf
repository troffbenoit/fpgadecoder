STANDARD(LVCMOS33), SIDE(TOP) {
    pin clk CLOCK FREQUENCY(100MHz)

    pin rst_n RESET

    pin led[0] LED0
    pin led[1] LED1
    pin led[2] LED2
    pin led[3] LED3
    pin led[4] LED4
    pin led[5] LED5
    pin led[6] LED6
    pin led[7] LED7

    pin usb_tx USB_TX

    pin br2_test B41
    pin br_rom_cs_n B42
    pin br_ram_cs_n B24
    pin br_uartb_cs_n B28
    pin br_acia_cs_n B30

}
